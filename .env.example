# Copy to .env.local (development) or .env.production.local (server) and fill in.
# Never commit the real file — .gitignore already excludes .env*.

# --- Email (Resend) -----------------------------------------------------------
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where website enquiries are delivered.
MAIL_TO=Kartikeyfasteners@gmail.com

# Sender. The domain must be verified in Resend (DKIM + SPF records),
# otherwise Resend rejects the send.
MAIL_FROM=Kartikey Fasteners <info@kaisoul.tech>

# --- Runtime ------------------------------------------------------------------
# Port the Node server binds to. The shared host's proxy forwards :443 here.
PORT=3000
HOSTNAME=127.0.0.1
